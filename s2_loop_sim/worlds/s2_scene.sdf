<?xml version="1.0"?>
<!--
  The world: the stage everything else is placed on. The launch file copies
  this to a temporary file with the randomised obstacles and waypoint stars
  appended as <include> blocks, and points Gazebo at the copy, so this file
  holds only what is the same on every run.

  See models/vehicle/vehicle.sdf for what model, link, visual and collision
  mean, and for the units and colour conventions used throughout.
-->
<sdf version="1.9">
  <world name="s2_scene">
    <!-- Earth gravity, pointing down the z axis. The world name matters: ROS
         topics and services from this world are namespaced under it, which is
         where /world/s2_scene/set_pose gets its middle section. -->
    <gravity>0 0 -9.81</gravity>
    <!-- Which collision solver to use. ODE is the default and is plenty for
         boxes and spheres. -->
    <physics name="default" type="ode">
    </physics>

    <!-- Sun. A directional light is infinitely far away, so only <direction>
         affects the shading; the pose is effectively decoration. -->
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane. Static, so physics never simulates it, and 100 m square,
         far larger than the 11 m walled arena the launch file spawns into.
         The plane's <normal> points up the z axis, making it horizontal. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================== VEHICLE ========================
         Pulled in from models/vehicle/vehicle.sdf. Gazebo resolves model://
         by searching GZ_SIM_RESOURCE_PATH, which the launch file sets. <name>
         is what the model is called in this world, and it is the name the
         movement engine addresses in its set_pose calls. It spawns slightly
         above the ground and drops the last few centimetres.

         The x, y and yaw below are mirrored by SDF_VEHICLE_START in
         constants.py, which is where the movement engine starts dead
         reckoning from and where the layout reserves the parking space.
         Move the vehicle here and that constant has to move too.
    -->
    <include>
      <uri>model://vehicle</uri>
      <name>vehicle</name>
      <pose>0 0 0.12 0 0 0</pose>
    </include>

  </world>
</sdf>
