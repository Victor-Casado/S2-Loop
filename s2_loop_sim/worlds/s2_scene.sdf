<?xml version="1.0"?>
<sdf version="1.9">
  <world name="s2_scene">
    <gravity>0 0 -9.81</gravity>
    <physics name="default" type="ode">
    </physics>

    <!-- Sun -->
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================== VEHICLE ======================== -->
    <include>
      <uri>model://vehicle</uri>
      <name>vehicle</name>
      <pose>0 0 0.2 0 0 0</pose>
    </include>

  </world>
</sdf>
