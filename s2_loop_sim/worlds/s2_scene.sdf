<?xml version="1.0"?>
<sdf version="1.9">
  <world name="s2_scene">
    <gravity>0 0 -9.81</gravity>
    <physics name="default" type="ode">
    </physics>

    <!-- Sun -->
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ======================== VEHICLE ======================== -->
    <include>
      <uri>model://vehicle</uri>
      <name>vehicle</name>
      <pose>0 0 0.2 0 0 0</pose>
    </include>

    <!-- ======================== SPHERICAL OBSTACLES ======================== -->
    <!-- Defined inline so each can have a unique radius -->

    <model name="obstacle_1">
      <pose>3.0 2.0 0.4 0 0 0</pose>
      <link name="body">
        <visual name="visual">
          <geometry>
            <sphere><radius>0.4</radius></sphere>
          </geometry>
          <material>
            <ambient>0.8 0.15 0.1 1.0</ambient>
            <diffuse>0.9 0.2 0.1 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.4</radius></sphere>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="obstacle_2">
      <pose>-2.5 3.5 0.5 0 0 0</pose>
      <link name="body">
        <visual name="visual">
          <geometry>
            <sphere><radius>0.5</radius></sphere>
          </geometry>
          <material>
            <ambient>0.8 0.15 0.1 1.0</ambient>
            <diffuse>0.9 0.2 0.1 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.5</radius></sphere>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="obstacle_3">
      <pose>4.0 -3.0 0.3 0 0 0</pose>
      <link name="body">
        <visual name="visual">
          <geometry>
            <sphere><radius>0.3</radius></sphere>
          </geometry>
          <material>
            <ambient>0.8 0.15 0.1 1.0</ambient>
            <diffuse>0.9 0.2 0.1 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.3</radius></sphere>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="obstacle_4">
      <pose>-3.5 -2.0 0.6 0 0 0</pose>
      <link name="body">
        <visual name="visual">
          <geometry>
            <sphere><radius>0.6</radius></sphere>
          </geometry>
          <material>
            <ambient>0.8 0.15 0.1 1.0</ambient>
            <diffuse>0.9 0.2 0.1 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.6</radius></sphere>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="obstacle_5">
      <pose>0.5 4.5 0.35 0 0 0</pose>
      <link name="body">
        <visual name="visual">
          <geometry>
            <sphere><radius>0.35</radius></sphere>
          </geometry>
          <material>
            <ambient>0.8 0.15 0.1 1.0</ambient>
            <diffuse>0.9 0.2 0.1 1.0</diffuse>
            <specular>0.3 0.3 0.3 1.0</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.35</radius></sphere>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ======================== WAYPOINT STARS ======================== -->
    <!-- Visual-only: gold five-point stars, no collision geometry -->

    <include>
      <uri>model://waypoint_star</uri>
      <name>waypoint_1</name>
      <pose>2.5 1.5 0.04 0 0 0</pose>
    </include>

    <include>
      <uri>model://waypoint_star</uri>
      <name>waypoint_2</name>
      <pose>-2.5 2.5 0.04 0 0 0</pose>
    </include>

    <include>
      <uri>model://waypoint_star</uri>
      <name>waypoint_3</name>
      <pose>3.5 -2.5 0.04 0 0 0</pose>
    </include>

    <include>
      <uri>model://waypoint_star</uri>
      <name>waypoint_4</name>
      <pose>-3.0 -1.5 0.04 0 0 0</pose>
    </include>

    <include>
      <uri>model://waypoint_star</uri>
      <name>waypoint_5</name>
      <pose>0.0 3.5 0.04 0 0 0</pose>
    </include>
  </world>
</sdf>