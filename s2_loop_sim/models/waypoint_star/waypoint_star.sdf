<?xml version="1.0"?>
<!--
  One waypoint marker. Five are placed on grid nodes each launch, inside
  the walled arena.

  Purely decorative: it has a visual and no collision, so the vehicle drives
  straight through it. Arriving at a waypoint will be decided by comparing
  coordinates, not by touching anything.

  Gazebo has no star primitive, so this is a <polyline>: a 2D outline in the xy
  plane, extruded upward by <height>. The ten points are the outer and inner
  vertices of a five pointed star, alternating, taken off circles of radius 0.2
  and 0.08 at 36 degree steps, which keeps the star inside one grid cell.
  It is the smallest of three concentric stars: green (0.3) and red (0.4)
  markers teleport over it to flag the active and unreachable waypoints.
  <emissive> adds a small amount of self-lit colour so the star stays yellow
  even where nothing is lighting it.
-->
<sdf version="1.9">
  <model name="waypoint_star">
    <static>true</static>
    <link name="star">
      <visual name="visual">
        <geometry>
          <polyline>
            <height>0.12</height>
            <point>0.000000 0.200000</point>
            <point>0.047023 0.064721</point>
            <point>0.190211 0.061803</point>
            <point>0.076085 -0.024721</point>
            <point>0.117557 -0.161803</point>
            <point>0.000000 -0.080000</point>
            <point>-0.117557 -0.161803</point>
            <point>-0.076085 -0.024721</point>
            <point>-0.190211 0.061803</point>
            <point>-0.047023 0.064721</point>
          </polyline>
        </geometry>
        <material>
          <ambient>1.0 0.8 0.0 1.0</ambient>
          <diffuse>1.0 0.8 0.0 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
          <emissive>0.2 0.16 0.0 1.0</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
