<?xml version="1.0"?>
<!--
  One obstacle. The launch file puts five of these on grid nodes.

  <static>true</static> tells the physics engine to skip simulating this body:
  it never falls, never gets pushed, and costs nothing per step. Other things
  still collide with it. See vehicle.sdf for how model, link, visual and
  collision fit together.
-->
<sdf version="1.9">
  <model name="sphere_obstacle">
    <static>true</static>
    <link name="body">
      <visual name="visual">
        <geometry>
          <sphere><radius>0.28</radius></sphere>
        </geometry>
        <material>
          <ambient>0.8 0.15 0.1 1.0</ambient>
          <diffuse>0.9 0.2 0.1 1.0</diffuse>
          <specular>0.3 0.3 0.3 1.0</specular>
        </material>
      </visual>
      <!-- Same radius as the visual, so what you see is what you hit. -->
      <collision name="collision">
        <geometry>
          <sphere><radius>0.28</radius></sphere>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
