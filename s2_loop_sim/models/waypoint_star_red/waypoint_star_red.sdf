<?xml version="1.0"?>
<!--
  The unreachable waypoint marker: a red star, the largest of the three
  concentric stars (outer radius 0.42 over green 0.41 over yellow 0.40), so
  teleporting it on top always reads as red no matter what is under it.
  Same star geometry as waypoint_star.sdf, scaled up two steps;
  visual-only, no collision. Height 0.62 stays a centimetre above green.
-->
<sdf version="1.9">
  <model name="waypoint_star_red">
    <static>true</static>
    <link name="star">
      <visual name="visual">
        <geometry>
          <polyline>
            <height>0.62</height>
            <point>0.000000 0.420000</point>
            <point>0.098748 0.135915</point>
            <point>0.399444 0.129787</point>
            <point>0.159778 -0.051915</point>
            <point>0.246870 -0.339787</point>
            <point>0.000000 -0.168000</point>
            <point>-0.246870 -0.339787</point>
            <point>-0.159778 -0.051915</point>
            <point>-0.399444 0.129787</point>
            <point>-0.098748 0.135915</point>
          </polyline>
        </geometry>
        <material>
          <ambient>0.8 0.0 0.0 1.0</ambient>
          <diffuse>0.8 0.0 0.0 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
          <emissive>0.3 0.0 0.0 1.0</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
