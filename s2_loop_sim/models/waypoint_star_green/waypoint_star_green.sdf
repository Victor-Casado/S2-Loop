<?xml version="1.0"?>
<!--
  The active waypoint marker: a green star, concentric with but larger than
  the yellow waypoint star (outer radius 0.3 over 0.2), so teleporting it
  on top reads as a recolor with a yellow centre. Same star geometry as
  waypoint_star.sdf, scaled up one step; visual-only, no collision.
-->
<sdf version="1.9">
  <model name="waypoint_star_green">
    <static>true</static>
    <link name="star">
      <visual name="visual">
        <geometry>
          <polyline>
            <height>0.12</height>
            <point>0.000000 0.300000</point>
            <point>0.070534 0.097082</point>
            <point>0.285317 0.092705</point>
            <point>0.114127 -0.037082</point>
            <point>0.176336 -0.242705</point>
            <point>0.000000 -0.120000</point>
            <point>-0.176336 -0.242705</point>
            <point>-0.114127 -0.037082</point>
            <point>-0.285317 0.092705</point>
            <point>-0.070534 0.097082</point>
          </polyline>
        </geometry>
        <material>
          <ambient>0.0 0.8 0.0 1.0</ambient>
          <diffuse>0.0 0.8 0.0 1.0</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
          <emissive>0.0 0.3 0.0 1.0</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
